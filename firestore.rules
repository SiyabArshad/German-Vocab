rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each authenticated user can only read and write their own progress document.
    // The document path is: /users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default (implicit, but explicit for clarity)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
